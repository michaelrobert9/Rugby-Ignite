rules_version = '2';

// Rugby Ignite reads and writes Firestore only from the server, using the
// Firebase Admin SDK (see src/lib/data/firebaseAdmin.ts). The Admin SDK
// bypasses these rules entirely, so we deny ALL direct client access.
//
// Nothing in the browser should ever touch Firestore directly. If that
// changes later (e.g. a public client-side read), open up only the specific
// collections that need it, and only for reads.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
