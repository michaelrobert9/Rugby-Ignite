# -------------------------------------------------------------------------
# Firebase Admin credentials (server-side only)
# -------------------------------------------------------------------------
# Copy this file to .env.local and fill in ONE of the options below.
# .env.local is git-ignored — never commit real credentials.
#
# Option A (recommended, works on any host): paste the FULL service-account
# key JSON as a single-line value, wrapped in single quotes. Get it from the
# Firebase console: Project settings -> Service accounts -> Generate new
# private key. Keep it on one line (the private_key already uses \n escapes).
#
# (On Firebase App Hosting this same value is provided as a Secret Manager
# secret named FIREBASE_SERVICE_ACCOUNT_KEY, exposed to the app under the
# SERVICE_ACCOUNT_KEY env var — see apphosting.yaml.)
#
# SERVICE_ACCOUNT_KEY='{"type":"service_account","project_id":"match-pulse-4560e", ... }'

SERVICE_ACCOUNT_KEY=

# Option B (instead of A): absolute path to the downloaded key file. This is
# also the default when deployed on Google Cloud / Firebase, where the
# ambient service account is used automatically.
#
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/serviceAccountKey.json


# -------------------------------------------------------------------------
# Firebase WEB config (client SDK) — used by the ADMIN LOGIN
# -------------------------------------------------------------------------
# The /admin section signs in against the shared Match Pulse Firebase project
# (same account) and only lets platform admins through. The browser needs the
# public web config below (safe to expose). On App Hosting these are already set
# in apphosting.yaml; set them here for local dev.
#
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyA1Q_HLScaii8-jQqKEf2ETTepw0HDG2P8
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=match-pulse-4560e.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=match-pulse-4560e
NEXT_PUBLIC_FIREBASE_APP_ID=1:161675532534:web:2ee33dbaf52575c19eb4d7

# -------------------------------------------------------------------------
# Admin session secret (server-side only) — signs the admin login cookie
# -------------------------------------------------------------------------
# A long random string (≥16 chars). NEVER commit the real value — on App Hosting
# store it as a Secret Manager secret (see apphosting.yaml). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=
